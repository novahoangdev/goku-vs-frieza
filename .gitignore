# build / render outputs (tools/build.sh regenerates them)
render/*
# except the final promo clip + previews used by the README (files under 100 MB)
!render/promo/
render/promo/*
!render/promo/saiyan-awakening-demo.mp4
!render/promo/saiyan-awakening-sheet.jpg
!render/promo/preview-transformation.gif
*.blend
*.blend1
app/assets/cinematic/cinematic.mp4

# versions/: keep only the notes of each version, not the videos / images / audio
versions/*
!versions/README.md
!versions/v*/
versions/v*/*
!versions/v*/NOTES.md

# app
app/node_modules/
app/ios/
app/android/
app/.expo/

# OS junk / patch leftovers
.DS_Store
*.orig
